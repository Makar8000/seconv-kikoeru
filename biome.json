{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": ["src/**", "!src/config/languages.json", "biome.json", "package.json", "tsconfig.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 150
  },
  "linter": {
    "rules": {
      "style": {
        "useBlockStatements": "error"
      }
    }
  }
}
